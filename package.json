{
	"name": "carbravo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc -b",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report",
		"verify": "pnpm check && pnpm typecheck && pnpm test:run && pnpm build",
		"ci": "pnpm verify",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@hookform/resolvers": "^5.7.1",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.85.0",
		"react-router-dom": "^7.18.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "^2.5.7",
		"@chromatic-com/storybook": "latest",
		"@playwright/test": "^1.62.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/addon-vitest": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.0.1",
		"playwright": "latest",
		"storybook": "^10.5.7",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	}
}
