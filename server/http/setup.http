  "financialProviderCode": "GM_FINANCIAL",
  "conditionCode": "CARBRAVO",
  "mileageCeiling": 75000,
  "topOfDeal": true,
  "vinException": false,
  "mfpnText": "Sample marketing text",
  "disclosureText": "Sample disclosure",
  "localeCode": "en-US",
  "deliveryStartDate": "2026-08-01",
  "deliveryEndDate": "2026-12-31",
  "effectiveStartDate": "2026-08-01",
