{
  "name": "carbravo-incentives-mock-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Temporary production-like Hono backend for the CarBravo Incentives Authoring app. Implements the /api contract defined in openapi.yaml against a persisted local JSON store, so the frontend can be swapped later to the real Spring Boot API by changing VITE_API_URL only.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "tunnel": "ngrok http --url=azalee-garmentless-serendipitously.ngrok-free.app 3001",
    "dev:tunnel": "concurrently -k -n API,TUNNEL -c blue,green \"pnpm dev\" \"pnpm tunnel\"",
    "start": "tsx src/index.ts",
    "seed:reset": "tsx src/seed.ts --reset",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock-api": "prism mock ./server/openapi.yaml -p 8080"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}