{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!public/favicon.svg", "!public/icons.svg", "!src/assets/*.svg"]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": "off"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
